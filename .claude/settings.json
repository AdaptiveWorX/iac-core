{
  "permissions": {
    "deny": [
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh api *merges*)",
      "Bash(gh api graphql *mergePullRequest*)",
      "Bash(gh api graphql *enablePullRequestAutoMerge*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(pnpm -r publish*)",
      "Bash(pnpm nx release publish*)",
      "Bash(nx release publish*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git * --no-verify*)",
      "Bash(infisical secrets*)",
      "Bash(infisical export*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  }
}
