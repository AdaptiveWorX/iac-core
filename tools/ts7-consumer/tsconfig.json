{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "types": ["node"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    // The point of the fixture: the packages' .d.ts files are checked, not skipped.
    "skipLibCheck": false
  },
  "include": ["src/**/*.ts"]
}
