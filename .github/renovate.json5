{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "group:monorepos",
    // Actions are referenced by immutable SHA, kept current via the version comment.
    "helpers:pinGitHubActionDigests",
  ],

  // --- Supply-chain delay (aligned with flow-04) ------------------------------
  // Every datasource (npm, Actions, .nvmrc Node, packageManager pnpm) waits 3
  // days, matching pnpm's strict minimumReleaseAge (4320 minutes) in
  // pnpm-workspace.yaml; "strict" opens no branch at all until the age passes.
  minimumReleaseAge: "3 days",
  internalChecksFilter: "strict",
  // API commits are Verified (signed by GitHub).
  platformCommit: "enabled",

  // --- Conventional-commit titles -------------------------------------------
  // pr-title.yml enforces a fixed scope allowlist (mirrors commitlint
  // scope-enum). Renovate's default "deps" scope is NOT in that list, so every
  // Renovate PR is pinned to `chore(repo)`, which is a valid scope and never
  // triggers an Nx Release version bump (correct for dependency hygiene PRs).
  // Renovate merges nothing itself (see the automerge policy below): every
  // Renovate PR is merged by hand, after the required `validate` +
  // `validate-title` checks.
  semanticCommits: "enabled",
  semanticCommitType: "chore",
  semanticCommitScope: "repo",

  // --- Range hygiene --------------------------------------------------------
  // Keep declared semver ranges (caret); update the range only when the new
  // version falls outside it. Never pin to or hold back at an old version.
  rangeStrategy: "replace",

  // --- Cadence / noise control ----------------------------------------------
  timezone: "America/Denver",
  schedule: ["before 6am on monday"],
  prConcurrentLimit: 10,
  prHourlyLimit: 4,
  labels: ["dependencies"],
  // Renovate PRs carry the `bot` label, which pr-title.yml lists in
  // ignoreLabels — a belt-and-suspenders fallback so a future scope tweak
  // can't silently wedge the title check.
  addLabels: ["bot"],

  // --- Automerge policy (security-architect, 2026-11-11) ----------------------
  // Renovate automerges NOTHING: no npm update, no lockfile maintenance, no
  // GitHub Action (first-party or not), no pin. The hosted app's merge right
  // would put a change on main without the EA, and main is what the main-only
  // environments trust. npm has a second reason: these packages are
  // published, the release build runs on whatever the lockfile resolves, and
  // npm trusted publishing is attached to it, so a compromised build-time
  // package could tamper with every consumer's install. This reverses the
  // 2026-11-10 ruling, which let first-party actions automerge. Non-major
  // Actions updates come as one grouped PR a week instead (packageRules).
  // Belt and braces: automerge is off globally, and no rule turns it on.
  automerge: false,

  // --- The drift-prevention engine ------------------------------------------
  // Weekly in-range lockfile refresh. This is what would have prevented the
  // 30 stale-transitive Dependabot alerts: it pulls transitive deps up to the
  // latest version already allowed by their parents' ranges. Reviewed by hand
  // like every npm update: it changes what the release build installs.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 6am on monday"],
    automerge: false,
  },

  // Renovate also opens prioritised PRs for known vulnerabilities (independent
  // of GitHub's Dependabot security alerts, which stay enabled). Security
  // fixes open at once (no schedule, no release age), never automerge, and are
  // labelled for pm-lead, who puts them on the EA's list. Majors keep
  // Dashboard approval through the packageRules below.
  vulnerabilityAlerts: {
    enabled: true,
    schedule: [],
    minimumReleaseAge: null,
    automerge: false,
    labels: ["security", "pm-lead"],
  },
  // Also read vulnerability data from OSV, which needs no GitHub alerts permission (security-architect, 2026-11-11).
  osvVulnerabilityAlerts: true,

  packageRules: [
    {
      // Lockfile maintenance has no release timestamp; pnpm's own
      // minimumReleaseAge enforces the 3 days on every version it resolves.
      matchUpdateTypes: ["lockFileMaintenance"],
      minimumReleaseAge: null,
    },
    {
      // Never auto-merge majors — they need a human (e.g. the vitest 3 -> 4
      // bump that quietly broke the test mocks). Flag them for review, and
      // open them only once approved on the Dependency Dashboard.
      matchUpdateTypes: ["major"],
      automerge: false,
      addLabels: ["major-update"],
      dependencyDashboardApproval: true,
    },
    {
      // Pulumi providers download a matching plugin binary at install; group
      // them so a bump and its peer move together and review stays coherent.
      matchPackageNames: ["/^@pulumi//"],
      groupName: "pulumi",
    },
    {
      // vitest and its @vitest/* plugins must share a version (they drifted a
      // major apart once: vitest 5 with coverage-v8 4).
      matchPackageNames: ["vite", "vitest", "/^@vitest//"],
      groupName: "vitest",
    },
    {
      // Nx core + plugins must move in lockstep, or the workspace breaks. Nx is
      // the release backbone (Nx Release drives versions, changelogs and the
      // tags npm trusted publishing hangs off), so its updates never automerge
      // and run `nx migrate` by hand.
      matchPackageNames: ["nx", "/^@nx//"],
      groupName: "nx monorepo",
      automerge: false,
    },
    {
      // Pinning an action to its digest freezes code already run: no
      // release-age delay (Actions only; still merged by hand).
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["pin", "pinDigest"],
      minimumReleaseAge: null,
    },
    {
      // GitHub Actions: every non-major update (minor, patch, digest, pin),
      // first-party or not, comes as one grouped PR on the Monday schedule, so
      // each week is one hand merge. Never automerged (security-architect,
      // 2026-11-11, reversing the 2026-11-10 first-party automerge): an action
      // can run in the release workflow, which holds npm trusted publishing.
      // Majors stay separate PRs, behind Dashboard approval (rule above).
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "pinDigest"],
      groupName: "GitHub Actions",
      automerge: false,
    },
    {
      // The build stays on TypeScript 6 until Nx supports 7 (Nx 23 reads
      // tsconfigs through the TypeScript JS API, which TS 7 dropped). A
      // TypeScript major for the build never automerges and waits for
      // Dashboard approval, so Renovate doesn't keep proposing it. The
      // tools/ts7-consumer fixture's own TS 7 alias is exempt (it's the check).
      matchPackageNames: ["typescript"],
      matchUpdateTypes: ["major"],
      matchFileNames: ["package.json", "packages/*/package.json"],
      dependencyDashboardApproval: true,
      automerge: false,
    },
    {
      // Shipped to consumers: runtime and peer dependencies of the published
      // packages never automerge, whatever the update type. Last, so it wins.
      matchFileNames: ["packages/*/package.json"],
      matchDepTypes: ["dependencies", "peerDependencies"],
      automerge: false,
    },
  ],
}
